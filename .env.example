# ── Gmail ────────────────────────────────────────────────────────────────────
# Your Gmail address (the one that sends the alert).
BMS_EMAIL_SENDER=your_email@gmail.com

# Who should receive the email (comma-separated).
BMS_EMAIL_RECIPIENTS=recipient1@gmail.com,recipient2@gmail.com

# 16-character Google App Password.
# Google Account → Security → 2-Step Verification → App Passwords → Other
BMS_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── ntfy.sh push notifications ───────────────────────────────────────────────
# Pick any topic name — it's like a channel. Subscribe to it in the ntfy app.
# Example: BMS_NTFY_TOPIC_ALERT=bms-alert-david123
# Install ntfy: https://ntfy.sh  |  Android / iOS / Desktop / Web

# High-priority persistent alert when tickets go live (re-sent every run
# until you turn off the monitor or dismiss it on your phone).
BMS_NTFY_TOPIC_ALERT=bms-ticket-alert

# Low-priority hourly heartbeat so you know the monitor is still running.
# Can be the same topic as ALERT, or a separate quieter one.
BMS_NTFY_TOPIC_HEARTBEAT=bms-heartbeat

# Optional: Bearer token if you use a private/self-hosted ntfy server.
# Leave blank for the free public ntfy.sh (no account needed).
BMS_NTFY_TOKEN=

# ── Monitor settings ─────────────────────────────────────────────────────────
BMS_STATE_FILE=state/state.json
BMS_TIMEZONE=Asia/Kolkata
